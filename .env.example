# .env.example
# Copiez ce fichier vers .env et ajustez les valeurs

# URL de base Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modèles pour chaque agent (ajustez selon vos modèles installés)
# Pour GTX 1650 4GB, utilisez des modèles légers
MODEL_INITIATEUR=qwen2.5:3b
MODEL_CREATIF=qwen2.5:3b
MODEL_CRITIQUE=qwen2.5:3b
MODEL_SYNTHETISEUR=qwen2.5:3b

# Modèle de secours si le modèle principal n'est pas disponible
MODEL_FALLBACK=gemma:2b

# Timeout des agents en secondes
TIMEOUT_AGENT=120
